flowchart TD

  %% ========== INGESTION (Audio &amp; Video) ==========
  A1["Audio File<br/>(MP3/WAV)"] --> B1["FastAPI Endpoint<br/><b>/ingest/audio</b>"]
  A2["Video File<br/>(MP4/MOV)"] --> B2["FastAPI Endpoint<br/><b>/ingest/video</b>"]

  B1 --> C[("Azure Blob Storage<br/><i>audio-files container</i>")]
  B2 --> C

  C --> D1["Azure CU<br/><b>Audio Analyzer</b><br/><i>transcription + fields</i>"]
  C --> D2["Azure CU<br/><b>Video Analyzer</b><br/><i>transcription + keyframes + fields</i>"]

  D1 --> E1["Transcript Phrases<br/>&amp; word timestamps"]
  D1 --> E2["Extracted Fields<br/>summary · topics · keywords<br/>drug_names · cancer_types<br/>biomarkers · speaker_names"]
  D2 --> E1
  D2 --> E2
  D2 --> E3["Keyframe Text &amp; Times<br/><i>slide text extraction</i>"]

  E1 --> F["Store Transcript<br/>&amp; Sentences"]
  E2 --> F
  E3 --> F

  F --> G["Create Overlapping Chunks<br/><i>shared services.py</i>"]

  G --> H["Azure AI Foundry<br/><b>text-embedding-3-large</b><br/><i>generate embeddings</i>"]

  H --> I["Azure AI Search<br/><b>media-chunks-v2</b><br/><i>shared hybrid vector index</i>"]

  C --> J[("PostgreSQL Database")]
  F --> J
  G --> J
  I --> J

  J --> K["Tables: audio_files / video_files,<br/>transcripts / video_transcripts,<br/>sentences / video_transcript_sentences,<br/>chunks / video_chunks"]

  %% ========== RETRIEVAL ==========
  L["💬 User Query"] --> M["Azure AI Foundry<br/><b>text-embedding-3-large</b><br/><i>embed query</i>"]

  M --> I

  I --> N["Top-K Matching Chunks<br/><i>across audio + video + web</i>"]

  N --> O["Fetch Full Context<br/>from PostgreSQL"]

  J --> O

  O --> P["Azure OpenAI<br/><b>GPT-4o via Foundry</b><br/><i>answer generation</i>"]

  P --> Q["Answer + Citations<br/><i>with source metadata</i>"]

  Q --> R["Source Metadata<br/>Title · Speaker · Timestamps<br/>Slide Text · Excerpt"]

  R --> S["Answer with<br/>Clickable Evidence"]
