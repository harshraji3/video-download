flowchart TD

  %% ========== INGESTION ==========
  A["Audio File<br/>(MP3/WAV)"] --> B["FastAPI Endpoint<br/><b>/ingest-audio</b>"]

  B --> C[("Azure Blob Storage<br/><i>audio-files container</i>")]
  C --> D["Azure Content Understanding<br/><b>:analyze</b><br/><i>transcription + field extraction</i>"]

  D --> E1["Transcript Phrases<br/>& word timestamps"]
  D --> E2["Extracted Fields<br/>summary · topics · keywords<br/>drug_names · cancer_types<br/>biomarkers · speaker_names<br/>company_name"]

  E1 --> F["Store Transcript<br/>& Sentences"]
  E2 --> F

  F --> G["Create Overlapping Chunks<br/><i>sliding window</i>"]

  G --> H["Azure AI Foundry Models<br/><b>text-embedding-3-large</b><br/><i>generate chunk embeddings</i>"]

  H --> I["Azure AI Search<br/><i>hybrid + vector index</i>"]

  C --> J[("PostgreSQL Database")]
  F --> J
  G --> J
  I --> J

  J --> K["Tables: audio_files,<br/>transcripts, sentences,<br/>chunks"]

  %% ========== RETRIEVAL ==========
  L["💬 User Query"] --> M["Azure AI Foundry Models<br/><b>text-embedding-3-large</b><br/><i>embed query</i>"]

  M --> I

  I --> N["Top-K Matching Chunks<br/><i>hybrid + vector search</i>"]

  N --> O["Fetch Full Context<br/>from PostgreSQL"]

  J --> O

  O --> P["Azure OpenAI<br/><b>GPT-4o</b><br/><i>answer generation</i>"]

  P --> Q["Answer + Citations<br/><i>with source metadata</i>"]

  Q --> R["Source Metadata<br/>Audio Title · Speaker<br/>Timestamps · Excerpt"]

  R --> S["Answer with<br/>Clickable Evidence"]